# Database (Supabase)
# Project Settings > Data API > Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings > API Keys > service_role. Server-only — never expose to the
# browser; it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin
ADMIN_PASSWORD=change-this-password

# Optional: named per-staff passwords, so actions are attributable and a single
# person can be revoked without rotating everyone's credential.
# Format: name:password, comma-separated. Passwords must not contain ',' and
# names must not be 'locked' or 'failed'. When set, it REPLACES ADMIN_PASSWORD.
# ADMIN_USERS=owner:owner-password,rider1:rider1-password

# Public origin, used to build absolute og:image / twitter:image URLs.
# No trailing slash. Falls back to the production host when unset.
NEXT_PUBLIC_SITE_URL=https://anchor-drops.vercel.app

# Facebook Integration
# Get these from Facebook Developer Portal: https://developers.facebook.com

# Meta Pixel ID (for tracking conversions)
# Found in Events Manager > Data Sources > Your Pixel
NEXT_PUBLIC_FB_PIXEL_ID=your-pixel-id

# Facebook Page ID (for Messenger Chat Plugin)
# Found in Page Settings > Page Info > Page ID
NEXT_PUBLIC_FB_PAGE_ID=your-page-id

# Page Access Token (for Messenger API - sending notifications)
# Generate in Facebook Developer Portal > Your App > Messenger > Settings
FB_PAGE_ACCESS_TOKEN=your-page-access-token

# Webhook Verify Token (any secret string you choose)
# Use this when setting up Messenger webhook in Facebook Developer Portal
FB_VERIFY_TOKEN=your-webhook-verify-token

# Facebook App Secret (for verifying webhook signatures)
# Found in Facebook Developer Portal > Your App > Settings > Basic
FB_APP_SECRET=your-app-secret

# Webhook Secret for ManyChat/FB order intake (REQUIRED — endpoint rejects without it)
FB_WEBHOOK_SECRET=your-manychat-webhook-secret

# HMAC key for reward OTP hashing (generate with: openssl rand -hex 32)
REWARD_CODE_SECRET=your-reward-code-secret

# Ops console (per-user Supabase Auth + RLS). Public keys, safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
